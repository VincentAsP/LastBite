# ============================================================
#  BACKEND .env
# ============================================================

# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_db_password
DB_NAME=food_waste_db

# JWT
JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter

# SMTP (untuk email reset password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password   # Gmail: buat App Password di Google Account

# SSL (opsional)
SSL_KEY_PATH=./ssl/key.pem
SSL_CERT_PATH=./ssl/cert.pem

# CORS
FRONTEND_URL=http://localhost:3000

# ============================================================
#  FRONTEND .env.local  (letakkan di root project Next.js)
# ============================================================

# API Backend
NEXT_PUBLIC_API_URL=http://localhost:5000

# Firebase (untuk push notification)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key
